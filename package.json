{
  "name": "@smallfishworld/open-code-review-svn",
  "version": "0.0.0",
  "description": "OpenCodeReview CLI fork with SVN workspace review support",
  "bin": {
    "ocr": "bin/ocr.js"
  },
  "files": [
    "bin/ocr.js",
    "scripts/install.js",
    "scripts/update.js",
    "scripts/version.js",
    "scripts/platform.js",
    "imgs/"
  ],
  "scripts": {
    "postinstall": "node scripts/install.js",
    "test:github-actions": "node scripts/github-actions/post-review-comments.test.js && node scripts/github-actions/check-translation-sync.test.js && node scripts/github-actions/action-contract.test.js",
    "test:update": "node scripts/version.test.js",
    "test:launcher": "node bin/ocr.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smallfishworld/open-code-review-svn.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "ocrConfig": {
    "urlPattern": "https://github.com/smallfishworld/open-code-review-svn/releases/download/v{version}/opencodereview-{os}-{arch}",
    "checksumPattern": "https://github.com/smallfishworld/open-code-review-svn/releases/download/v{version}/sha256sum.txt"
  },
  "optionalDependencies": {
    "@smallfishworld/ocr-darwin-arm64": "0.0.0",
    "@smallfishworld/ocr-darwin-x64": "0.0.0",
    "@smallfishworld/ocr-linux-arm64": "0.0.0",
    "@smallfishworld/ocr-linux-x64": "0.0.0",
    "@smallfishworld/ocr-win32-arm64": "0.0.0",
    "@smallfishworld/ocr-win32-x64": "0.0.0"
  },
  "engines": {
    "node": ">=14"
  },
  "license": "Apache-2.0"
}
